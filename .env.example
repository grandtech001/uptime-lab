# Copy to .env and adjust. Nothing here is a real secret yet: replacing this
# file with AWS Secrets Manager + IRSA is stage 4.

# Shared by checker-api and scheduler.
DATABASE_URL=postgres://uptime:uptime@localhost:5432/uptime
# Set to "require" for RDS or any managed Postgres. Leave unset locally.
# PGSSLMODE=require

# checker-api
PORT=3001

# scheduler
SWEEP_CRON=*/2 * * * *
PRUNE_CRON=30 3 * * *
PROBE_TIMEOUT_MS=10000
RETENTION_DAYS=30

# gateway
CHECKER_API_URL=http://localhost:3001
CORS_ORIGIN=*
